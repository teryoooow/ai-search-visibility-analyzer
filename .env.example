# ── Optional GEO "LLM second opinion" ────────────────────────────────
# The core SEO/AEO/GEO analysis is fully deterministic and needs NO keys.
# Enable the enrichment layer with any OpenAI-compatible provider:
#
#   GEO_LLM_API_KEY=sk-...            # required (or OPENAI_API_KEY)
#   GEO_LLM_BASE_URL=https://api.openai.com/v1
#                                     # DeepSeek:    https://api.deepseek.com/v1
#                                     # Groq:        https://api.groq.com/openai/v1
#                                     # OpenRouter:  https://openrouter.ai/api/v1
#                                     # Ollama local: http://localhost:11434/v1 (no key needed)
#   GEO_LLM_MODEL=gpt-4o-mini         # optional; auto-guessed per provider
#
# ── Server ───────────────────────────────────────────────────────────
# PORT=3100
